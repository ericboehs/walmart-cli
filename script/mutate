#!/usr/bin/env ruby
# frozen_string_literal: true

# Break the code on purpose, run a command, put it back.
#
# Why this exists rather than a one-off search-and-replace: twice tonight an
# edit silently changed nothing -- the pattern did not match, nothing said so,
# and the suite passed. A passing suite after a no-op edit is indistinguishable
# from a passing suite after a real one, which turns every mutation result into
# a coin flip and quietly reports the opposite of the truth. So the first thing
# this does is prove the mutation happened. If the file did not change, it
# aborts before running anything.
#
# Usage:
#   script/mutate --file lib/walmart/commands/order.rb \
#                 --from 'SETTLED = %w[complete cutoff]' \
#                 --to   'SETTLED = %w[complete cutoff page_limit]' \
#                 -- rake test
#
#   script/mutate --plan mutants.json -- rake test
#
# A plan is a JSON array of {label, file, from, to}. Each is applied alone,
# the command is run, and the file is restored before the next one -- including
# when the command fails, when it raises, and when you interrupt it.
#
# Exit status is 0 when every mutant was caught (the command failed for each
# one), 1 when any mutant survived. That inversion is the point: a surviving
# mutant is the bad news, and it should be the failing exit code.

require "fileutils"
require "json"
require "open3"

class Mutation
  attr_reader :label, :file, :from, :to, :command

  def initialize(label:, file:, from:, to:, command: nil)
    @label = label
    @file = file
    @from = from
    @to = to
    @command = command
  end

  def self.from_json(entry, index)
    missing = %w[file from to] - entry.keys
    raise "mutant #{index}: missing #{missing.join(", ")}" unless missing.empty?

    new(label: entry["label"] || "#{entry["file"]}: #{entry["from"][0, 40]}",
        file: entry["file"], from: entry["from"], to: entry["to"],
        # A plan spans both languages, so a mutant may name the suite that
        # should notice it. Running the whole of CI for each one is slower and,
        # worse, blurs which suite is doing the catching.
        command: entry["command"])
  end

  # Returns the original text, or raises. The raise is the whole point: an
  # absent pattern is a broken mutant, not a surviving one, and the two mean
  # opposite things about the code under test.
  def apply
    original = File.read(file)
    occurrences = original.scan(from).length
    raise "MUTATION DID NOT APPLY: #{from.inspect} not found in #{file}" if occurrences.zero?

    raise "MUTATION IS AMBIGUOUS: #{from.inspect} appears #{occurrences} times" if occurrences > 1

    mutated = original.sub(from, to)
    raise "MUTATION CHANGED NOTHING: --from and --to are the same text" if mutated == original

    File.write(file, mutated)
    original
  end

  def restore(original)
    File.write(file, original)
  end
end

class Runner
  def initialize(command, verbose:)
    @command = command
    @verbose = verbose
  end

  # A mutant is "caught" when the command fails. Anything that makes the command
  # fail counts, which is why the tail of its output is printed -- a mutant
  # caught by a syntax error is not evidence of a test doing its job.
  def caught?(mutation)
    original = mutation.apply
    begin
      out, status = run(mutation.command)
      report(mutation, out, status)
      !status.success?
    ensure
      # Not conditional on success, on the exception, or on anything else. The
      # one thing this script must never do is leave the tree broken.
      mutation.restore(original)
    end
  end

  # Not a predicate: it reports as it goes, and the caller stops on false.
  def baseline(commands) # rubocop:disable Naming/PredicateMethod
    commands.each do |command|
      out, status = run(command)
      next if status.success?

      warn "the suite does not pass before any mutation is applied; fix that first"
      warn "  #{(command || @command).join(" ")}"
      warn indent(tail(out))
      return false
    end
    true
  end

  private

  def run(command = nil)
    out, err, status = Open3.capture3(*(command || @command))
    [out + err, status]
  end

  def report(mutation, out, status)
    verdict = status.success? ? "SURVIVED" : "caught"
    puts format("%<verdict>-9s %<label>s", verdict: verdict, label: mutation.label)
    puts indent(tail(out)) if @verbose || status.success?
  end

  def tail(out, lines: 6)
    out.strip.split("\n").last(lines).join("\n")
  end

  def indent(text)
    text.split("\n").map { |line| "          #{line}" }.join("\n")
  end
end

def parse_argv(argv)
  split = argv.index("--")
  raise "no command given; put it after --" if split.nil?

  flags = {}
  args = argv[0...split]
  until args.empty?
    key = args.shift
    raise "unknown flag: #{key}" unless key.start_with?("--")

    boolean = %w[--verbose --allow-dirty].include?(key)
    flags[key.delete_prefix("--").to_sym] = boolean ? true : args.shift
  end
  [flags, argv[(split + 1)..]]
end

def mutations_from(flags)
  if flags[:plan]
    JSON.parse(File.read(flags[:plan])).each_with_index.map { |entry, i| Mutation.from_json(entry, i) }
  else
    missing = %i[file from to] - flags.keys
    raise "need --file, --from and --to (or --plan); missing #{missing.join(", ")}" unless missing.empty?

    [Mutation.from_json({ "file" => flags[:file], "from" => flags[:from], "to" => flags[:to] }, 0)]
  end
end

# Files this run will edit in place, which must be committed or stashed first.
#
# Mutation testing rewrites tracked source and restores it afterwards. Two
# things follow. Uncommitted work in a file the plan touches would be captured
# as the "original" and, if this process is killed rather than raising, left
# mutated with no clean copy to compare against. And a second person -- or a
# second agent -- running `git status` mid-run sees a modified tracked file and
# has no way to tell a mutation from someone's edit. That happened: a peer
# reviewing this repo found lib/walmart/secrets.rb modified, correctly refused
# to touch it, and stopped. It was a mutant, mid-flight.
BACKUP_DIR = File.join(__dir__, "..", ".git", "mutate-backup")

# Files this run will edit in place.
#
# Mutation testing rewrites tracked source and restores it in an ensure. That
# covers exceptions, including Interrupt, but not SIGKILL -- and if the process
# is hard-killed with uncommitted work in a planned file, the only clean copy
# was in memory. A bystander running `git status` mid-run also cannot tell a
# mutation from someone's edit; that happened, on a secrets file, and the
# reviewer correctly stopped.
#
# Committed work needs neither protection: `git checkout` restores it. So the
# default is to refuse a dirty planned file, and --allow-dirty takes a real
# on-disk backup first rather than trusting the ensure.
def guard_planned_files(mutations, allow_dirty:)
  dirty = mutations.map(&:file).uniq.reject do |file|
    `git status --porcelain -- #{file}`.strip.empty?
  end
  return if dirty.empty?

  unless allow_dirty
    raise "uncommitted changes in #{dirty.join(", ")}. Commit them, or pass --allow-dirty " \
          "to back them up to .git/mutate-backup first. A hard kill mid-run would otherwise " \
          "leave them mutated with no clean copy anywhere"
  end

  back_up(dirty)
end

def back_up(files)
  FileUtils.mkdir_p(BACKUP_DIR)
  files.each do |file|
    target = File.join(BACKUP_DIR, file.tr("/", "_"))
    FileUtils.cp(file, target)
    warn "backed up #{file} -> #{target}"
  end
end

# A backup left behind means a previous run did not finish. Say so before doing
# anything else, because the next run's "original" would be the mutated file.
def warn_about_abandoned_backups
  leftovers = Dir[File.join(BACKUP_DIR, "*")]
  return if leftovers.empty?

  warn "a previous mutation run left backups behind; it may have been killed mid-run:"
  leftovers.each { |path| warn "  #{path}" }
  warn "compare them against your working tree before trusting this run"
end

def main(argv)
  flags, command = parse_argv(argv)
  mutations = mutations_from(flags)
  runner = Runner.new(command, verbose: flags[:verbose])

  warn_about_abandoned_backups
  guard_planned_files(mutations, allow_dirty: flags[:"allow-dirty"])
  # Says so on stderr, so anyone reading this tree while it runs knows why a
  # tracked file is modified.
  warn "mutating tracked files in place; the tree is dirty until this finishes"

  puts "checking the suite passes untouched first"
  return 1 unless runner.baseline(mutations.map(&:command).uniq)

  survivors = mutations.reject { |mutation| runner.caught?(mutation) }
  # Only on a clean finish. A run that raised leaves them, which is what the
  # abandoned-backup warning is for.
  FileUtils.rm_rf(BACKUP_DIR)

  if survivors.empty?
    puts "#{mutations.length} mutants, #{mutations.length} caught"
    0
  else
    puts "#{survivors.length} of #{mutations.length} mutants SURVIVED:"
    survivors.each { |mutation| puts "  #{mutation.label}" }
    1
  end
rescue StandardError => e
  # A broken mutant and a surviving mutant are opposite findings, so this must
  # not read like a test failure. No backtrace: the message is the whole point.
  warn "mutate: #{e.message}"
  2
end

exit(main(ARGV)) if $PROGRAM_NAME == __FILE__
