#!/usr/bin/env ruby
# frozen_string_literal: true

# Runs the real CLI end to end and looks at the bytes.
#
# Every defect this script checks for was invisible to the unit suite and
# visible in under a minute of running the command and reading stdout: an empty
# document, prose where JSON was promised, a wrong exit code. The tests assert
# what the code should do; this asserts what it actually emitted.
#
# No network and no browser. WALMART_PYTHON points the worker at a stub that
# speaks the real protocol over the real pipes, so the CLI, the worker
# transport, the parsers and the formatters are all genuine -- only Walmart is
# not. XDG paths are redirected into a temp directory, so a run cannot see or
# touch a real archive, profile, or config.
#
# Usage: script/smoke [--verbose]

require "json"
require "fileutils"
require "tmpdir"
require "open3"

ROOT = File.expand_path("..", __dir__)
VERBOSE = ARGV.include?("--verbose")

# A credential-shaped string, planted where a real password would be and
# checked for on every stream of every case.
#
# This only means something because a fake `security` on PATH actually hands it
# over: the Keychain provider, the Secret wrapper, the worker request and the
# error formatter all see the real thing. Without that the check was a
# decoration -- it scanned output that could not contain a credential, in a run
# where no credential existed.
CANARY = "smoke-canary-secret-value"

# Canned worker replies, keyed by action. Shapes copied from the parsers'
# tests, which were written against observed payloads.
WORKER_REPLIES = {
  "probe" => {
    "python" => "3.10.17", "playwright" => "1.47.0", "browser" => "chromium",
    "profile_exists" => true
  },
  "session.status" => { "signed_in" => true, "checked_at" => "2026-08-26T03:00:00Z" },
  "search" => {
    "items" => [
      { "item_id" => "10450114", "name" => "Great Value Whole Milk, 1 Gallon",
        "price" => 3.12, "price_display" => "$3.12", "first_party" => true,
        "seller_name" => "Walmart.com", "availability" => "IN_STOCK", "can_add" => true }
    ],
    "pagination" => { "page" => 1, "has_more" => false }
  },
  "item" => {
    "item_id" => "10450114", "name" => "Great Value Whole Milk, 1 Gallon",
    "brand" => "Great Value", "price" => 3.12, "price_display" => "$3.12",
    "seller_name" => "Walmart.com", "seller_type" => "INTERNAL", "first_party" => true,
    "availability" => "IN_STOCK", "min_quantity" => 1, "max_quantity" => 12,
    "snap_eligible" => true,
    "fulfillment_options" => [{ "type" => "DELIVERY", "available" => true, "label" => "Delivery" }],
    "variants" => { "has_variants" => false, "count" => 0, "shape_unobserved" => false }
  },
  "cart.show" => {
    "lines" => [
      { "item_id" => "10450114", "name" => "Great Value Whole Milk, 1 Gallon",
        "quantity" => 1, "quantity_display" => "1", "price" => 3.12 }
    ],
    "totals" => { "subtotal" => 3.12 }, "problems" => []
  },
  "order.sync" => {
    "orders" => [
      { "order_id" => "200012345678901", "display_id" => "2000123-45678",
        "date" => "2026-08-20T14:02:00.000Z", "type" => "delivery", "item_count" => 1,
        "totals" => { "grand_total" => 3.12 },
        "items" => [{ "item_id" => "10450114", "name" => "Great Value Whole Milk, 1 Gallon",
                      "quantity_display" => "1", "price" => 3.12 }] }
    ],
    "seen" => [{ "order_id" => "200012345678901" }],
    "stopped" => { "reason" => "complete" }
  }
}.freeze

# Actions the stub should fail, to exercise the error paths that only ever run
# when something has gone wrong -- the half of the code the unit tests reach
# least and reviewers reach never.
WORKER_FAILURES = {
  "challenge" => { "code" => "challenge_detected", "message" => "Walmart asked for a human" },
  "login_required" => { "code" => "login_required", "message" => "not signed in" }
}.freeze

def stub_worker_source
  <<~RUBY
    require "json"
    request = JSON.parse($stdin.read)
    action = request["action"]
    replies = JSON.parse(#{WORKER_REPLIES.to_json.dump})
    failures = JSON.parse(#{WORKER_FAILURES.to_json.dump})

    stop = ENV["SMOKE_STOP_REASON"]
    if stop && !stop.empty? && action == "order.sync"
      data = replies.fetch("order.sync").dup
      data["stopped"] = { "reason" => stop, "cursor" => "eyJvIjoxfQ==",
                          "oldest_date" => "2026-08-20T14:02:00.000Z" }
      puts({ "type" => "result", "data" => data }.to_json)
      exit 0
    end

    # A worker that quotes its input back in an error. Not hypothetical: a
    # stray log line on the Python side would do exactly this, and it is the
    # shape the canary exists to catch.
    if ENV["SMOKE_LEAK_PROBE"] == "1"
      puts({ "type" => "error", "code" => "leak_probe",
             "message" => "worker failed on " + JSON.generate(request) }.to_json)
      exit 0
    end

    force = ENV["SMOKE_FORCE_FAILURE"]
    if force && !force.empty?
      failure = failures.fetch(force)
      puts({ "type" => "error", "code" => failure["code"],
             "message" => failure["message"] }.to_json)
      exit 0
    end

    if replies.key?(action)
      puts({ "type" => "result", "data" => replies[action] }.to_json)
    else
      puts({ "type" => "error", "code" => "not_implemented",
             "message" => action + " is not implemented" }.to_json)
    end
  RUBY
end

class Smoke
  Case = Struct.new(:label, :argv, :exit_code, :expect, :fresh, keyword_init: true)

  def initialize
    @failures = []
    @checked = 0
  end

  attr_reader :failures, :checked

  def run
    Dir.mktmpdir("walmart-smoke") do |dir|
      @dir = dir
      write_stub
      cases.each { |kase| check(kase) }
    end
    report
  end

  private

  def write_stub
    @stub = File.join(@dir, "stub-worker.rb")
    File.write(@stub, stub_worker_source)
    File.chmod(0o700, @stub)
    write_fake_security
  end

  # Stands in for macOS `security`, so the credential path is exercised with a
  # value we can then hunt for. -w means "print the password"; without it the
  # provider is only probing for presence and must not get a value.
  def write_fake_security
    @bin = File.join(@dir, "bin")
    FileUtils.mkdir_p(@bin)
    path = File.join(@bin, "security")
    File.write(path, <<~SH)
      #!/bin/sh
      case " $* " in
        *" -w "*) echo "#{CANARY}" ;;
        *) echo "password has been deleted" ;;
      esac
      exit 0
    SH
    File.chmod(0o755, path)
  end

  # `ruby stub.rb` stands in for `python fetch.py`: the CLI appends the real
  # script path, which the stub ignores.
  # Cases share one XDG root by default, deliberately: it means `order list`
  # reads what `order sync` actually wrote to disk, rather than a fixture that
  # agrees with the writer by construction. A case marked fresh gets its own
  # root, for the states that only exist before anything has happened.
  def env(extra = {}, fresh: nil)
    root = fresh ? File.join(@dir, "fresh-#{fresh}") : File.join(@dir, "main")
    {
      "HOME" => root,
      "XDG_CONFIG_HOME" => File.join(root, "config"),
      "XDG_DATA_HOME" => File.join(root, "data"),
      "XDG_STATE_HOME" => File.join(root, "state"),
      "XDG_CACHE_HOME" => File.join(root, "cache"),
      "WALMART_PYTHON" => "#{RbConfig.ruby} #{@stub}",
      "PATH" => "#{@bin}:#{ENV.fetch("PATH", "")}",
      "NO_COLOR" => "1",
      "SMOKE_FORCE_FAILURE" => "",
      "SMOKE_STOP_REASON" => "",
      "SMOKE_LEAK_PROBE" => ""
    }.merge(extra)
  end

  def cases = Plan.new.cases

  # A case's expectation doubles as its stub configuration: what the worker is
  # told to do and what we then demand of the output are one description, so
  # the two cannot drift apart.
  def plan_for(expect)
    return [{}, expect, nil, false] unless expect.is_a?(Hash)

    extra = {}
    extra["SMOKE_FORCE_FAILURE"] = expect[:failure] if expect[:failure]
    extra["SMOKE_STOP_REASON"] = expect[:stop] if expect[:stop]
    extra["SMOKE_LEAK_PROBE"] = "1" if expect[:leak]
    [extra, expect[:json] ? :json : expect[:text], expect[:code], expect[:leak] == true]
  end

  def check(kase)
    extra, expect, code, leak_probe = plan_for(kase.expect)
    out, err, status = Open3.capture3(env(extra, fresh: kase.fresh), RbConfig.ruby, "-I#{ROOT}/lib",
                                      "#{ROOT}/bin/walmart", *kase.argv)
    @checked += 1
    puts "\n$ walmart #{kase.argv.join(" ")}\n#{out}" if VERBOSE

    assert_exit(kase, status)
    return assert_canary_is_detectable(kase, out, err) if leak_probe

    assert_no_canary(kase, out, err)
    expect == :json ? assert_one_document(kase, out, code: code) : assert_matches(kase, out, err, expect)
  end

  def assert_exit(kase, status)
    return if kase.exit_code.nil? || status.exitstatus == kase.exit_code

    fail!(kase, "expected exit #{kase.exit_code}, got #{status.exitstatus}")
  end

  # The whole point of --json. Zero bytes is the failure that looks like
  # success right up until a parser sees it.
  #
  # "Some valid JSON came out" is the weakest claim in this file -- weaker than
  # an exit code, because it is satisfied by the process producing bytes at
  # all. It is the right assertion for the cases that exist to pin the
  # one-document contract, and the wrong one for a case with a name like
  # "login required", which has to be able to tell one failure from another.
  # So a code can be demanded, and the success cases at least have to not be
  # errors.
  def assert_one_document(kase, out, code: nil)
    return fail!(kase, "stdout was empty; --json promises a document") if out.strip.empty?

    document = JSON.parse(out)
    error = document.is_a?(Hash) ? document["error"] : nil
    return assert_error_code(kase, error, code) if code

    fail!(kase, "expected a result, got error #{error["code"].inspect}") if error
  rescue JSON::ParserError => e
    fail!(kase, "stdout was not one JSON document (#{e.message.lines.first.strip})")
  end

  def assert_error_code(kase, error, code)
    return fail!(kase, "expected error #{code.inspect}, got a result document") unless error
    return if error["code"] == code

    fail!(kase, "expected error #{code.inspect}, got #{error["code"].inspect}")
  end

  def assert_matches(kase, out, err, expect)
    return if expect.nil? || out.match?(expect) || err.match?(expect)

    fail!(kase, "output did not match #{expect.inspect}")
  end

  def assert_no_canary(kase, out, err)
    return unless canary?(out, err)

    fail!(kase, "a credential-shaped value reached the output")
  end

  # Deliberately inverted: this one has to find it, using the same predicate
  # every other case trusts to come back false.
  def assert_canary_is_detectable(kase, out, err)
    return if canary?(out, err)

    fail!(kase, "planted a credential in the worker's reply and the check did not see it; " \
                "every other canary assertion in this suite is now meaningless")
  end

  def canary?(out, err) = "#{out}#{err}".include?(CANARY)

  def fail!(kase, reason)
    @failures << "#{kase.label}: #{reason}"
  end

  def report
    if failures.empty?
      puts "smoke: #{checked} checks passed"
      return 0
    end

    warn "smoke: #{failures.length} of #{checked} checks failed"
    failures.each { |line| warn "  #{line}" }
    1
  end
end

# Builds the case list. Separate from the runner because these are two
# different questions -- what should be true, and did it turn out to be --
# and mixing them is how a suite ends up with cases nobody re-reads.
class Plan
  Case = Smoke::Case

  def cases
    read_cases + stop_cases + json_cases + failure_cases + credential_cases + [leak_probe_case]
  end

  # The negative control, and the reason the canary check is worth anything.
  #
  # A check for the absence of something passes just as happily when the thing
  # could never have been there -- which is what the first version of this did,
  # scanning for a credential in a run that had none. So one case makes the
  # leak really happen: a stub that quotes the request back in its error, a
  # real password read from the provider, carried through the real worker
  # transport and printed by the real error reporter. If this case stops
  # finding the canary, then either credentials no longer reach the worker or
  # the detector is no longer wired to what a user sees, and in both of those
  # worlds every other canary assertion has quietly become decoration again.
  def leak_probe_case
    Case.new(label: "the canary check can actually catch a leak", argv: %w[login --verbose],
             exit_code: nil, expect: { leak: true }, fresh: "leak")
  end

  # Every case is scanned for the canary, but these are the ones that put a
  # credential in motion: read from the provider, wrapped, handed to the worker
  # and -- in the failing case -- carried into an error report with --verbose,
  # which is the switch whose whole job is to print more of what happened.
  def credential_cases
    [
      Case.new(label: "doctor sees the credential without printing it", argv: %w[doctor --verbose],
               exit_code: nil, expect: /credentials/),
      Case.new(label: "a failing login does not print what it was given",
               argv: %w[login --verbose], exit_code: nil,
               expect: { failure: "challenge", text: /./ }),
      Case.new(label: "a failing login in json mode does not print it either",
               argv: %w[login --json --verbose], exit_code: nil,
               expect: { failure: "challenge", json: true, code: "challenge_detected" })
    ]
  end

  # The exit code on a partial sync is the most consequential byte this tool
  # produces: it is the difference between a script believing it has two years
  # of history and knowing it has some. A unit test can only say that a method
  # returns 3; only this can say that a process exits 3, through the real
  # dispatcher, formatter and top-level rescue.
  #
  # Both states are here on purpose. One case cannot tell 3 from a constant 3,
  # and the mutation that mattered -- always report success -- is invisible
  # without the stopped case to contrast with the complete one.
  def stop_cases
    [
      Case.new(label: "sync stopped early (exit 3)", argv: %w[order sync], exit_code: 3,
               expect: { stop: "page_changed", text: /stopped early/ }, fresh: "stopped"),
      Case.new(label: "sync stopped early (json, exit 3)", argv: ["order", "sync", "--json"],
               exit_code: 3, expect: { stop: "page_changed", json: true }, fresh: "stopped-json"),
      Case.new(label: "sync complete (exit 0)", argv: %w[order sync], exit_code: 0,
               expect: /archived 1 order/, fresh: "complete"),
      # A stopped sync must leave an archive that knows it is partial, and it
      # has to survive the process that wrote it -- so this reads it back from
      # disk in a later run rather than trusting the writer.
      Case.new(label: "archive admits it is incomplete", argv: %w[order list], exit_code: 0,
               expect: /archive is incomplete.+page_changed/m, fresh: "stopped")
    ]
  end

  # The ordinary surface, in text mode.
  def read_cases
    [
      Case.new(label: "version", argv: %w[version], exit_code: 0, expect: /walmart-cli \d/),
      Case.new(label: "help", argv: %w[help], exit_code: 0, expect: /Available now/),
      # doctor's exit code is a fact about this machine, not about the code:
      # 1 when a check fails, and a machine without Chrome is a legitimate 1.
      Case.new(label: "doctor", argv: %w[doctor], exit_code: nil, expect: /python/),
      Case.new(label: "search", argv: %w[search milk], exit_code: 0, expect: /Great Value/),
      Case.new(label: "item", argv: %w[item 10450114], exit_code: 0, expect: /Walmart\.com \(Walmart\)/),
      Case.new(label: "cart show", argv: %w[cart show], exit_code: 0, expect: /Great Value/),
      Case.new(label: "order sync", argv: %w[order sync], exit_code: 0, expect: /archived 1 order/),
      # Ordering matters here: this runs after `order sync` against the same
      # XDG root, so it proves the record survived a write and a read of a
      # real file rather than agreeing with the writer in memory.
      Case.new(label: "order list (after sync)", argv: %w[order list], exit_code: 0,
               expect: /200012345678901/),
      Case.new(label: "order show (after sync)", argv: %w[order show 200012345678901],
               exit_code: 0, expect: /Great Value/),
      Case.new(label: "order search (after sync)", argv: %w[order search milk],
               exit_code: 0, expect: /Great Value/),
      Case.new(label: "order list (never synced)", argv: %w[order list], exit_code: 0,
               expect: /No matches/, fresh: "empty"),
      Case.new(label: "unknown command", argv: %w[teleport], exit_code: 2, expect: nil)
    ]
  end

  # Every one of these must print exactly one JSON document to stdout. The
  # empty and error paths are the ones that were broken, so they are listed
  # first-class rather than assumed.
  #
  # Each entry declares whether it expects a result or a specific error, and
  # that is the whole point: a case that only requires parseable bytes cannot
  # tell a result from a failure, let alone one failure from another. Naming
  # the code also stops a command from quietly changing which error it reports.
  # argv, the error code expected (nil means a result document), and the exit
  # status. The pair is the point: a document and a status are two independent
  # ways to be wrong, and a script reads both. doctor is the only nil status
  # here, because its exit really is a fact about the machine it runs on.
  JSON_CASES = [
    [%w[version], nil, 0], [%w[help], nil, 0], [%w[doctor], nil, nil],
    [%w[search milk], nil, 0], [%w[item 10450114], nil, 0], [%w[cart show], nil, 0],
    [%w[order sync], nil, 0], [%w[order list], nil, 0], [%w[order search milk], nil, 0],
    [%w[order show 200012345678901], nil, 0], [[], nil, 0],
    [%w[order show nope], "not_found", 1],
    [%w[search], "usage", 2],
    [%w[teleport], "unknown_command", 2]
  ].freeze

  def json_cases
    JSON_CASES.map do |argv, code, exit_code|
      Case.new(label: "json: #{argv.join(" ").inspect}", argv: argv + ["--json"],
               exit_code: exit_code, expect: { json: true, code: code })
    end + empty_json_cases
  end

  # The empty path needs its own root or it is not empty. Without these the
  # suite ran every JSON case against an archive that `order sync` had already
  # filled, so the one bug this section exists to catch -- a document that is
  # zero bytes when there is nothing to report -- could not fail it.
  def empty_json_cases
    [
      [%w[order list], nil, 0], [%w[order search saffron], nil, 0],
      [%w[order show nope], "not_found", 1]
    ].each_with_index.map do |(argv, code, exit_code), index|
      Case.new(label: "json (never synced): #{argv.join(" ").inspect}",
               argv: argv + ["--json"], exit_code: exit_code,
               expect: { json: true, code: code }, fresh: "json-empty-#{index}")
    end
  end

  # A worker that fails is the normal case, not the exceptional one: Walmart
  # can challenge or sign us out at any moment.
  def failure_cases
    [
      Case.new(label: "challenge (text)", argv: %w[search milk], exit_code: 1,
               expect: { failure: "challenge", text: /asked for a human/ }),
      # exit_code: nil here used to mean "the machine decides", copied from
      # doctor, where that is true. Nothing is machine-dependent about these:
      # the stub picks the failure and the mapping is deterministic. That nil
      # is what let a transport error agree with the failure being tested.
      Case.new(label: "challenge (json)", argv: %w[search milk --json], exit_code: 1,
               expect: { failure: "challenge", json: true, code: "challenge_detected" }),
      Case.new(label: "login required (json)", argv: ["cart", "show", "--json"], exit_code: 1,
               expect: { failure: "login_required", json: true, code: "login_required" })
    ]
  end
end

exit Smoke.new.run
