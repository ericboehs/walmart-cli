#!/bin/sh
# Run the gates before a commit is made, not after it is pushed.
#
# This exists because a commit went in with a failing test. The gates were run
# -- the failure was in the output -- and the commit command was chained after
# them, so a non-zero exit scrolled past and nothing stopped it. There were no
# hooks in this repository at all; the discipline was entirely in the habit of
# whoever was typing, and a habit does not fail loudly.
#
# Install with `rake hooks`. Never bypass with --no-verify: if a gate is wrong,
# fix the gate.
set -e

cd "$(git rev-parse --show-toplevel)"
exec rake
